# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MySQL Database Configuration (Required for Coolify / Production MySQL Deployment)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="ege_database"
# Alternatively, pass full connection URL:
# DATABASE_URL="mysql://user:password@host:3306/ege_database"
